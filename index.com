<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Kindle Sokoban Sprite Size Test</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#fff;color:#000;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%}
body{padding:6px}
h1{font-size:24px;margin:0 0 3px;font-weight:900}
.sub{font-size:13px;margin:0 0 7px}
.metrics{font-size:12px;border:2px solid #000;padding:5px;margin:0 0 7px}
table{border-collapse:collapse;border-spacing:0;width:auto;max-width:none;margin:0 auto}
th,td{padding:1px;text-align:center;vertical-align:middle;border-bottom:1px solid #bbb}
thead th{font-size:12px;font-weight:900;border-bottom:2px solid #000}
.name{width:69px;min-width:69px;max-width:69px;text-align:left;font-size:10px;line-height:1.05;padding-right:3px}
.spritecell{padding:0 1px;height:100px}
.spritecell img{display:block;margin:0 auto;object-fit:contain}
.group th{text-align:left;font-size:13px;padding:7px 2px 3px;border-bottom:2px solid #000}
.note{font-size:11px;line-height:1.3;border:2px solid #000;padding:5px;margin:8px 0 2px}
</style>
</head>
<body>
<h1>SOKOBAN SPRITE SIZE TEST</h1>
<div class="sub">Actual CSS display sizes: 48 → 96 px</div>
<div class="metrics" id="metrics">Measuring Kindle viewport…</div>

<table>
<thead>
<tr>
<th class="name">SPRITE</th>
<th style="width:50px">48</th><th style="width:58px">56</th><th style="width:66px">64</th><th style="width:74px">72</th><th style="width:82px">80</th><th style="width:90px">88</th><th style="width:98px">96</th>
</tr>
</thead>
